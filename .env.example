# Copy this file to `.env` and `.env.test`, then adjust the values.
# `.env.test` must use another DB__NAME, so tests never run against the development database.

# Database (required)
DB__NAME="db"

# Database (optional)
# DB__USER="root"
# DB__PASSWORD="root"
# DB__HOST="localhost"
# DB__PORT=5432

# Application (optional)
# DEBUG=false
# ALLOW_ORIGINS='["*"]'
# VERSION="0.0.0"
# PROFILE="<profile>"
